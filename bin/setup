#!/usr/bin/env bash
OPENSIM_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"

declare GRIDS
for GRID in ${OPENSIM_DIR}/share/grids/* ; do
    GRIDS=("${GRIDS[@]}" "`basename \"${GRID}\"`")
done

if [ $# -eq 0 ]; then
    echo "Usage: ${0} gridname"
    echo "Available grids are: ${GRIDS[@]}"
    exit 0
fi

GRID=${1}

if [ ! -d "${OPENSIM_DIR}/share/grids/${GRID}" ]; then
    echo "Error: No such grid"
    echo "Available grids are: ${GRIDS[@]}"
    exit 0
fi

mkdir -p "${OPENSIM_DIR}/etc"
mkdir -p "${OPENSIM_DIR}/etc/robust-include"
mkdir -p "${OPENSIM_DIR}/etc/sims-include"
mkdir -p "${OPENSIM_DIR}/etc/sims-available"
mkdir -p "${OPENSIM_DIR}/etc/sims-enabled"
mkdir -p "${OPENSIM_DIR}/runtime/bin"

echo "Installing files and settings needed for ${GRID}"
cp -r "${OPENSIM_DIR}/share/grids/${GRID}/." "${OPENSIM_DIR}"

echo "Installing common files and settings"
cp -r "${OPENSIM_DIR}/share/common/." "${OPENSIM_DIR}"

if [ -d "${OPENSIM_DIR}/etc/robust.d" ]; then
    ROBUST_DB_INI="${OPENSIM_DIR}/etc/robust-include/database.ini"
    if [ ! -r "${ROBUST_DB_INI}" ]; then
        echo "Installing template ini for robust database at ${ROBUST_DB_INI} - please edit this file afterwards"
        echo -e "[DatabaseService]\nStorageProvider = \"OpenSim.Data.MySQL.dll\"\nConnectionString = \"DataSource=localhost;Database=SQL_DATABASE_NAME;User Id=SQL_USER_NAME;password=SQL_USER_PASSWORD;Old Guids=true;SslMode=None;\"" > "${ROBUST_DB_INI}"
        chmod 600 "${ROBUST_DB_INI}"
    fi
fi
SIM_DB_INI="${OPENSIM_DIR}/etc/sims-include/database.ini"
if [ ! -r "${SIM_DB_INI}" ]; then
    if [ -r "${ROBUST_DB_INI}" ]; then
        echo "Re-using robust database settings for simulators by softlinking"
        echo "If you want the simulators in a seperate database, replace ${SIM_DB_INI}"
        ln -s "${ROBUST_DB_INI}" "${SIM_DB_INI}"
    else
        echo "Installing template ini for sims database at ${SIM_DB_INI} - please edit this file afterwards"
        echo -e "[DatabaseService]\nStorageProvider = \"OpenSim.Data.MySQL.dll\"\nConnectionString = \"DataSource=localhost;Database=SQL_DATABASE_NAME;User Id=SQL_USER_NAME;password=SQL_USER_PASSWORD;Old Guids=true;SslMode=None;\"" > "${SIM_DB_INI}"
    fi
    chmod 600 "${SIMS_DB_INI}"
fi

echo "Protecting passwords"
chmod 600 ${OPENSIM_DIR}/etc/addins/*
chmod 600 ${OPENSIM_DIR}/etc/sims-include/*

if [ -r "${OPENSIM_DIR}/etc/sims-include/estate.ini" ]; then
   echo "Preserving existing estate settings"
else
    DefaultEstateName="My Estate"
    read -r -p "Default estate name (${DefaultEstateName}): "
    if [ -n "${REPLY}" ]; then
        DefaultEstateName=${REPLY}
    fi

    DefaultEstateOwnerName="Firstname Lastname"
    read -r -p "Default estate owner (${DefaultEstateOwnerName}): "
    if [ -n "${REPLY}" ]; then
        DefaultEstateOwnerName=${REPLY}
    fi
    ESTATES_INI="${OPENSIM_DIR}/etc/sims-include/estate.ini"
    echo -e "[Estates]\nDefaultEstateName = \"${DefaultEstateName}\"\nDefaultEstateOwnerName = \"${DefaultEstateOwnerName}\"\n\n" > "${ESTATES_INI}"
    echo "[DatabaseService]" >> "${ESTATES_INI}"
    echo "; To keep estate data across instances/servers centralised (optional):" >> "${ESTATES_INI}"
    echo "; In mariadb/mysql (note we don't limit this user to localhost):" >> "${ESTATES_INI}"
    echo ";   create database estates;" >> "${ESTATES_INI}"
    echo ";   grant all on estates.* to estates identified by 'ESTATES_PASSWORD';" >> "${ESTATES_INI}"
    echo "; Then uncomment and edit EstateConnectionString:" >> "${ESTATES_INI}"
    echo -e ";EstateConnectionString = \"Data Source=SERVER_IP;Database=estates;User ID=opensim_estates;Password=ESTATES_PASSWORD;Old Guids=true;SslMode=None;\"\n" >> "${ESTATES_INI}"
fi

echo "Please review etc/sims-include/estate.ini if you want estate data to be stored centralised to be shared across multiple instances/servers."

echo "Done"

